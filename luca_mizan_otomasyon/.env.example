# Bu dosyayı ".env" olarak kopyalayıp kendi bilgilerinizi girin.
# .env dosyasını KİMSEYLE PAYLAŞMAYIN ve versiyon kontrolüne (git) eklemeyin.

# --- Luca giriş bilgileri ---
LUCA_UYE_NO=
LUCA_KULLANICI_ADI=
LUCA_PAROLA=

# --- Mizan filtre varsayılanları (script çalışırken de değiştirebilirsiniz) ---
MIZAN_YIL=2026
# SINIF kodları: 1=1.Sınıf, 2=2.Sınıf, 3=İşletme Defteri, 4=Serbest Meslek Defteri, 5=Basit Usül
MIZAN_SINIF=1

# --- Çıktı klasörü ---
CIKTI_KLASORU=raporlar
