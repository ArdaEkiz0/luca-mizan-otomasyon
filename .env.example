# ============================================================
#  Luca Mizan Raporu Otomasyonu — Örnek Ayarlar
# ============================================================
# Bu dosyayı ".env" olarak kopyalayıp kendi bilgilerinizi girin:
#
#     cp .env.example .env        (macOS/Linux)
#     copy .env.example .env      (Windows)
#
# .env dosyasını KİMSEYLE PAYLAŞMAYIN ve git'e EKLEMEYİN.
# Bu dosya (.env.example) güvenlidir; yalnızca boş şablon içerir.

# --- Luca giriş bilgileri ---
LUCA_UYE_NO=
LUCA_KULLANICI_ADI=
LUCA_PAROLA=

# --- Mizan filtre varsayılanları (arayüzden de değiştirebilirsiniz) ---
MIZAN_YIL=2026
# SINIF kodları: 1=1.Sınıf, 2=2.Sınıf, 3=İşletme Defteri, 4=Serbest Meslek Defteri, 5=Basit Usül
MIZAN_SINIF=1

# --- Çıktı klasörü ---
CIKTI_KLASORU=raporlar